{
  "name": "cms-pwa-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:cms": "npm run dev --workspace=apps/cms",
    "dev:pwa": "npm run dev --workspace=apps/pwa",
